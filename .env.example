# ============================================================
# TikTok Creator PWA — Required Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
# Project URL (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anon/public key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...

# Service role key — SERVER ONLY, never send to browser
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# ── Cloudinary ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret     # SERVER ONLY

# ── Inngest ───────────────────────────────────────────────────
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key

# ── App ───────────────────────────────────────────────────────
# Must be HTTPS in production (required for camera/PWA)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ── Admin ─────────────────────────────────────────────────────
# Secret token to access /[locale]/admin and /api/admin/* routes
ADMIN_SECRET=your-strong-secret-here

# ── Optional (Phase 2) ────────────────────────────────────────
# TikTok Login Kit
# TIKTOK_CLIENT_KEY=your-tiktok-client-key
# TIKTOK_CLIENT_SECRET=your-tiktok-client-secret   # SERVER ONLY

# ── Funny AI image (FREE only — no payment) ───────────────────
# Default: Cloudinary Generative Replace (uses your existing Cloudinary free tier)
# Fallback: Pollinations.ai (no key)
# Optional upgrade — free Google AI Studio key (no credit card):
#   https://aistudio.google.com/apikey
# GEMINI_API_KEY=...                                # SERVER ONLY

# FFmpeg font paths (defaults work on most Linux/Vercel)
# AMHARIC_FONT_PATH=/usr/share/fonts/noto/NotoSerifEthiopic-Regular.ttf
# ENGLISH_FONT_PATH=/usr/share/fonts/truetype/liberation/LiberationSans-Bold.ttf
